                </testStep>
                <testStep testStepId="2" name="Activate_Plugin" method="Activate_Plugin" pluginName="Controller">
                    <conditionalExecution enable="true" Id="1" useMethodTag="controller_get_plugin_state" arguments="isDeactivated,org.rdk.PersistentStore" />
                    <params>
                        <param tag="callsign" value="org.rdk.PersistentStore" />
                    </params>
                </testStep>
                <testStep testStepId="3" name="Check_PluginActive_Status" method="Get_Plugin_Status" pluginName="Controller">
                    <conditionalExecution enable="true" Id="1" useMethodTag="controller_get_plugin_state" arguments="isDeactivated,org.rdk.PersistentStore" />
                    <params>
                        <param tag="plugin" value="org.rdk.PersistentStore" indexOnly="true" />
                    </params>
                    <resultGeneration useMethodTag="controller_get_plugin_state" arguments="check_status,org.rdk.PersistentStore" expectedValues="activated" />
                </testStep>
            </prerequisite>
        </testCasePreRequisite>
        <testStep testStepId="1" name="Deactivate_PersistentStore_Plugin" method="Deactivate_Plugin" pluginName="Controller">
            <params>
                <param tag="callsign" value="org.rdk.PersistentStore" />
            </params>
        </testStep>
        <testStep testStepId="2" name="Check_State_Change_Event" event="Event_Controller_State_Changed" action="eventListener" delay="2" pluginName="Controller">
            <resultGeneration useMethodTag="controller_check_state_change_event" expectedValues="org.rdk.persistentstore,deactivated,requested" />
        </testStep>
        <testStep testStepId="3" name="Check_PluginActive_Status" method="Get_Plugin_Status" pluginName="Controller">
            <params>
                <param tag="plugin" value="org.rdk.PersistentStore" indexOnly="true" />
            </params>
            <resultGeneration useMethodTag="controller_get_plugin_state" arguments="check_status,org.rdk.PersistentStore" expectedValues="deactivated" />
        </testStep>
        <testStep testStepId="4" name="Activate_org.rdk.PersistentStore_Plugin" method="Activate_Plugin" pluginName="Controller" delay="1">
            <params>
                <param tag="callsign" value="org.rdk.PersistentStore" />
            </params>
        </testStep>
        <testStep testStepId="5" name="Check_State_Change_Event" event="Event_Controller_State_Changed" action="eventListener" delay="2" pluginName="Controller">
            <resultGeneration useMethodTag="controller_check_state_change_event" expectedValues="org.rdk.persistentstore,activated,requested" />
        </testStep>
        <testStep testStepId="6" name="Check_PluginActive_Status" method="Get_Plugin_Status" pluginName="Controller" PluginOnStep="yes">
            <params>
                <param tag="plugin" value="org.rdk.PersistentStore" indexOnly="true" />
            </params>
            <resultGeneration useMethodTag="controller_get_plugin_state" arguments="check_status,org.rdk.PersistentStore" expectedValues="activated" />
        </testStep>
    </testCase>

